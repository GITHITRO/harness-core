[0m$ [0mpython -c "
import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
pred = tr['previous_hp'].fillna(0) - tr['damage_dealt'].fillna(0) + tr['healing_applied'].fillna(0)
pred = pred.clip(lower=0)
pred = np.minimum(pred, tr['max_hp'].fillna(tr['previous_hp'].fillna(0)))
resid = tr['pikachu_hp'] - pred
from sklearn.metrics import r2_score
print('rule R2 on train:', r2_score(tr['pikachu_hp'], pred))
print('resid describe:'); print(resid.describe())
print('resid value counts:'); print(resid.value_counts().head(15))
print('exact match fraction:', (resid==0).mean())
print('within 1:', (resid.abs()<=1).mean())
print('within 2:', (resid.abs()<=2).mean())
print('max_hp unique:', sorted(tr['max_hp'].dropna().unique()))
print('pikachu_hp > max_hp?', (tr['pikachu_hp']>tr['max_hp']).sum())
"

