[0m$ [0mpython -c "
import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
te = pd.read_csv('/data/test.csv')
print('train rounds:', tr['round'].min(), tr['round'].max(), 'n rounds:', tr['round'].nunique())
print('test rounds:', te['round'].min(), te['round'].max(), 'n rounds:', te['round'].nunique())
print('round overlap:', set(te['round'].unique()) & set(tr['round'].unique()))
print('train turn range:', tr['turn'].min(), tr['turn'].max())
print('test turn range:', te['turn'].min(), te['turn'].max())
cats = ['opponent_pokemon','opponent_type','move_used','move_type','move_category','weather_condition','pikachu_status','terrain_type','held_item','pikachu_ability']
for c in cats:
    trv = set(tr[c].dropna().unique()); tev = set(te[c].dropna().unique())
    new = tev - trv
    print(c, 'train nuniq', len(trv), 'test nuniq', len(tev), 'new in test:', len(new), sorted(new)[:10] if new else '')
"

