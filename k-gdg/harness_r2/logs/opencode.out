Confirmed: `n_jobs=4` with categorical features causes sporadic NaN predictions (LightGBM parallel nondeterminism). Fix: `n_jobs=1` plus a rule-based fallback for any non-finite prediction.
[0m← [0mEdit finalize.py
Index: /work/finalize.py
===================================================================
--- /work/finalize.py
+++ /work/finalize.py
@@ -25,16 +25,21 @@
 params = dict(
     n_estimators=300, learning_rate=0.03, num_leaves=32,
     min_child_samples=61, subsample=0.626, colsample_bytree=0.968,
     reg_alpha=0.65, reg_lambda=1.37,
-    random_state=42, n_jobs=4, verbosity=-1,
+    random_state=42, n_jobs=1, verbosity=-1,
 )
 m = lgb.LGBMRegressor(**params)
 m.fit(X, y, categorical_feature=cat_cols)
 
 p = m.predict(Xt)
-p = np.clip(p, 0, te["max_hp"].to_numpy())
+# safety net: rule-based hp for any non-finite prediction
+rule = (te["previous_hp"].fillna(0) - te["damage_dealt"].fillna(0) + te["healing_applied"].fillna(0))
+rule = np.clip(rule, 0, te["max_hp"].fillna(54))
+p = np.where(np.isfinite(p), p, rule)
+p = np.clip(p, 0, te["max_hp"].fillna(54).to_numpy())
 p = np.rint(p).astype(int)
+print("non-finite predictions replaced:", int((~np.isfinite(m.predict(Xt))).sum()))
 
 out = pd.DataFrame({"battle_turn": te["battle_turn"], "pikachu_hp": p})
 out = out.set_index("battle_turn").loc[sub["battle_turn"]].reset_index()
 assert list(out["battle_turn"]) == list(sub["battle_turn"])

