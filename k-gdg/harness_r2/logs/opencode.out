import pandas as pd, numpy as np, lightgbm as lgb
tr = pd.read_csv('/data/train.csv')
te = pd.read_csv('/data/test.csv')
feature_cols = [c for c in tr.columns if c not in ('battle_turn','pikachu_hp')]
for df in (tr,te):
    df['net_hp_change'] = df['healing_applied'].fillna(0) - df['damage_dealt'].fillna(0)
    df['hp_ratio'] = df['previous_hp'].fillna(df['max_hp']) / df['max_hp'].fillna(df['previous_hp'].fillna(54))
    df['num_missing'] = df.isna().sum(axis=1)
feature_cols = [c for c in tr.columns if c not in ('battle_turn','pikachu_hp')]
cat_cols=[c for c in feature_cols if tr[c].dtype==object]
for c in cat_cols:
    tr[c]=tr[c].astype('category'); te[c]=te[c].astype('category')
X=tr[feature_cols]; y=tr['pikachu_hp'].astype(float); Xt=te[feature_cols]
m=lgb.LGBMRegressor(n_estimators=300,learning_rate=0.03,num_leaves=32,min_child_samples=61,subsample=0.626,colsample_bytree=0.968,reg_alpha=0.65,reg_lambda=1.37,random_state=42,n_jobs=4,verbosity=-1)
m.fit(X,y,categorical_feature=cat_cols)
p=m.predict(Xt)
bad = np.where(~np.isfinite(p) | (np.abs(p)>1e6))[0]
print('bad rows:', bad)
for i in bad[:10]:
    row = te.iloc[i]
    print(i, row['battle_turn'], 'num_missing', row['num_missing'] if 'num_missing' in row else 'na')
    print(row[feature_cols].isna().sum(), 'nas')
print('pred at bad:', p[bad[:5]])
"

