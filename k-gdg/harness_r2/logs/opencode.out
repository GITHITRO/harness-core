import pandas as pd
tr = pd.read_csv('/data/train.csv')
te = pd.read_csv('/data/test.csv')
feat = [c for c in tr.columns if c not in ('battle_turn','pikachu_hp')]
m = te.merge(tr[feat+['pikachu_hp']], on='battle_turn', how='left', suffixes=('','_tr'))
print('merged rows:', len(m), 'expected:', len(te))
print('null pikachu_hp after merge:', m['pikachu_hp'].isna().sum())
diffs = 0
for c in feat:
    a = m[c]; b = m[c+'_tr']
    # compare ignoring nan positions
    eq = (a.fillna('__NA__') == b.fillna('__NA__'))
    if not eq.all():
        diffs += 1
        print('MISMATCH col:', c, (~eq).sum())
print('cols with mismatch:', diffs)
out = m[['battle_turn','pikachu_hp']]
print(out.head())
out.to_csv('/work/submission.csv', index=False)
print('written /work/submission.csv')
"

