import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
# check relation: hp vs previous_hp - damage + heal
r = tr['pikachu_hp'] - (tr['previous_hp'] - tr['damage_dealt'] + tr['healing_applied'])
print(r.describe())
print('unique residuals:', sorted(r.unique())[:20], '...', sorted(r.unique())[-5:])
print('corr hp with prev_hp:', tr['pikachu_hp'].corr(tr['previous_hp']))
print('corr hp with damage:', tr['pikachu_hp'].corr(tr['damage_dealt']))
print('corr hp with heal:', tr['pikachu_hp'].corr(tr['healing_applied']))
print('nulls:', tr.isnull().sum().sum(), te:=pd.read_csv('/data/test.csv')).isnull().sum().sum() if False else ''
