import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
# test exact formula candidates
for name, f in [
  ('prev-dmg+heal', tr['previous_hp']-tr['damage_dealt']+tr['healing_applied']),
  ('prev-dmg', tr['previous_hp']-tr['damage_dealt']),
  ('prev', tr['previous_hp']),
]:
    e = (tr['pikachu_hp'] - f).abs()
    print(name, 'exact match %:', (e==0).mean(), 'mae:', e.mean())
