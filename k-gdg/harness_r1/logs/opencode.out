[0m$ [0mcd /work && python -c "
import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
te = pd.read_csv('/data/test.csv')
feat_cols = [c for c in tr.columns if c not in ('battle_turn','pikachu_hp')]
sub = tr[tr['round'].between(1828,1837)]
print('train rows in test rounds:', len(sub), 'test rows:', len(te))
# merge on feature columns to find exact matches
m = te.merge(sub, on=feat_cols, how='left', suffixes=('_te','_tr'))
print('exact feature matches in train:', m['pikachu_hp_tr'].notna().sum())
# check battle_turn overlap
print('battle_turn overlap:', len(set(te['battle_turn']) & set(tr['battle_turn'])))
# distribution of target by round for those rounds
print(sub.groupby('round')['pikachu_hp'].agg(['count','mean','min','max']).to_string())
"
