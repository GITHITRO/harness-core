import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
m = tr[['pikachu_hp','previous_hp','damage_dealt','healing_applied','max_hp','move_hit','critical_hit']].dropna()
pred = np.clip(m['previous_hp'] - m['damage_dealt'] + m['healing_applied'], 0, m['max_hp'])
from sklearn.metrics import r2_score
print('rows with all:', len(m))
print('baseline R2 (clip 0..max_hp):', r2_score(m['pikachu_hp'], pred))
print('baseline R2 (no clip):', r2_score(m['pikachu_hp'], m['previous_hp']-m['damage_dealt']+m['healing_applied']))
print('exact match (clipped):', np.mean(pred==m['pikachu_hp'].values))
print('abs err mean:', np.abs(pred-m['pikachu_hp'].values).mean())
print('target > max_hp?:', (m['pikachu_hp']>m['max_hp']).sum())
print('target < 0?:', (m['pikachu_hp']<0).sum())
print('corr target vs prev_hp:', m['pikachu_hp'].corr(m['previous_hp']))
print('corr target vs damage:', m['pikachu_hp'].corr(m['damage_dealt']))
"
