# Agent sandbox: OpenCode + CPU ML stack. Same image for both arms; no network at run time.
FROM python:3.12-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends nodejs npm git ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir -q pandas==2.2.3 numpy==2.1.3 scikit-learn==1.6.1 lightgbm==4.6.0 xgboost==2.1.4 \
    catboost==1.2.8 scipy==1.15.2 optuna==4.2.1 pyarrow==19.0.1
RUN npm install -g --silent opencode-ai@1.19.5
RUN useradd -m agent && mkdir -p /work && chown agent /work
USER agent
WORKDIR /work
# Pre-install the OpenAI-compatible provider package while the build still has network (run time has none).
RUN mkdir -p /home/agent/.config/opencode && printf '%s' '{"provider":{"kilo":{"npm":"@ai-sdk/openai-compatible","options":{"baseURL":"http://127.0.0.1:9/v1","apiKey":"x"},"models":{"m":{"name":"m"}}}},"model":"kilo/m","small_model":"kilo/m"}' > /home/agent/.config/opencode/opencode.json \
    && (timeout 120 opencode run --print-logs "hi" > /dev/null 2>&1 || true) && rm /home/agent/.config/opencode/opencode.json \
    && ls /home/agent/.cache/opencode 2>/dev/null | head
