import pandas as pd, numpy as np
tr = pd.read_csv('/data/train.csv')
y = (tr['satisfaction']=='True').astype(int)
for c in tr.columns[1:-1]:
    if tr[c].dtype==object:
        ct = pd.crosstab(tr[c], y)
        pure = ((ct.min(axis=1)==0)).mean()
        if pure>0.95: print(c, 'pure-split ratio', pure)
    else:
        print(c, 'pointbiserial approx corr:', np.corrcoef(tr[c].fillna(0), y)[0,1])
